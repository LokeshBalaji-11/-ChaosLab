{
  "name": "chaos-lab-topology",
  "version": "1.0.0",
  "description": "E-commerce service topology and impact analysis with React Flow",
  "main": "server/app.ts",
  "type": "commonjs",
  "scripts": {
    "server": "ts-node server/app.ts",
    "client": "vite --port 3000",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "tsc --noEmit && vite build",
    "test": "jest"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.3",
    "concurrently": "^8.2.2",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0",
    "vite": "^5.3.1",
    "@vitejs/plugin-react": "^4.3.1"
  }
}